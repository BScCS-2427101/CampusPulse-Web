# Backend Environment Variables Configuration
# Allowed CORS origins, comma-separated
CORS_ORIGINS=https://campuspulse.vercel.app,http://localhost:5173,http://localhost:3000

# Directory for persistent live dataset (e.g. Render persistent disk mount /var/data)
# PERSISTENT_DATA_DIR=/var/data

# Custom path to original dataset (defaults to backend/data/CampusPulse_Academic_Dataset_Original.xlsx)
# ORIGINAL_DATASET_PATH=/app/backend/data/CampusPulse_Academic_Dataset_Original.xlsx

# Custom path to live dataset (defaults to persistent disk or backend/data/CampusPulse_Live_Data.xlsx)
# LIVE_DATASET_PATH=/var/data/CampusPulse_Live_Data.xlsx
